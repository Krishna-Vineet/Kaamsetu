# ─────────────────────────────────────────────────────────────────────────────
# KaamSetu API — environment template
# Copy to `.env` and fill in real values. NEVER commit your real .env.
# See docs/KEY_ROTATION.md for how to obtain/rotate every secret below.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | production
PORT=5000

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>/kaamsetu?retryWrites=true&w=majority
# Atlas → Database → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/kaamsetu

# ── Auth tokens ──────────────────────────────────────────────────────────────
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value for each of the three secrets below.
JWT_SECRET=replace_with_96_char_random_hex
JWT_REFRESH_SECRET=replace_with_another_96_char_random_hex

# ── Admin panel ──────────────────────────────────────────────────────────────
# Password used to unlock the admin dashboard (POST /admin/verify).
ADMIN_PASSWORD=replace_with_a_long_random_admin_password
# Separate signing secret for admin session tokens (2h lifetime by default).
ADMIN_JWT_SECRET=replace_with_a_third_96_char_random_hex
ADMIN_SESSION_TTL=7200               # seconds (default 2h)

# ── Email (Resend) — OTP + notification emails ───────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain verified in Resend (or onboarding@resend.dev for testing).
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=KaamSetu

# ── SMS (Twilio) — phone OTPs ────────────────────────────────────────────────
# https://console.twilio.com/  → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx     # your Twilio number in E.164 format

# ── Media (Cloudinary) — profile photos / Aadhaar documents ─────────────────
# https://console.cloudinary.com/  → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Maps (OpenRouteService) — road-distance calculation (optional) ───────────
# Free tier: https://openrouteservice.org/dev/#/signup
# Without this key the API falls back to straight-line (Haversine) distances.
OPENROUTESERVICE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins. Defaults to the KaamSetu
# production subdomains; localhost is added automatically outside production.
ALLOWED_ORIGINS=https://kaamsetu.co.in,https://www.kaamsetu.co.in,https://app.kaamsetu.co.in,https://admin.kaamsetu.co.in

# ── Cookies (auth) ───────────────────────────────────────────────────────────
# Defaults are production-secure: httpOnly=true, secure=true, sameSite=none.
# For LOCAL development over http://localhost use the values below instead:
#   COOKIE_SECURE=false
#   COOKIE_SAME_SITE=lax
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
# Optional: share cookies across subdomains, e.g. COOKIE_DOMAIN=.kaamsetu.co.in
# COOKIE_DOMAIN=
