# ─────────────────────────────────────────────────────────────────────────────
# KaamSetu Web App (client-facing) — environment template
# Copy to `.env` for local dev. In Vercel, set these as Environment Variables.
# Vite only exposes variables prefixed with VITE_ to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the KaamSetu API (no trailing slash)
# Local:      http://localhost:5000
# Production: https://api.kaamsetu.co.in
VITE_API_URL=http://localhost:5000

# OpenRouteService key for road-distance display in the browser (optional).
# Public by nature (browser-visible) — lock it down with domain restrictions
# in your ORS dashboard. Falls back to straight-line distance when unset.
VITE_ORS_API_KEY=
