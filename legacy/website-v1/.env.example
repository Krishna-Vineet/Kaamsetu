# ─────────────────────────────────────────────────────────────────────────────
# KaamSetu v1 (LEGACY / archived) — environment template
# Copy to `.env` in THIS folder:  copy .env.example .env   (Windows)
# Note: v1 uses DIFFERENT variable names than v2 (MONGO_URI, not MONGODB_URI).
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection string (note the v1 name!)
# Without a reachable database the app still starts in "view-only demo mode":
# static pages render, but login/registration/dashboards won't work.
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/kaamsetu

# Auth
JWT_SECRET=any_long_random_string_here

# Port (default 3000)
PORT=3000
NODE_ENV=development

# Cloudinary (file uploads — optional for browsing pages)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Gmail SMTP via nodemailer (only used for some notification flows — optional)
EMAIL_USER=
EMAIL_PASS=
